# 根编排环境变量（docker compose 自动读取）
POSTGRES_DB=devops_platform
POSTGRES_USER=devops
POSTGRES_PASSWORD=devops
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=8000
ASGI_PORT=8001
FRONTEND_PORT=80

# 后端容器内 Django 配置（同时请确保 backend/.env 存在，可由 backend/.env.example 复制）
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=please-change-me-to-a-long-random-string
JWT_SIGNING_KEY=please-change-me-jwt-signing-key
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=ChangeMe123!
